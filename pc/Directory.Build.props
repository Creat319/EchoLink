<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <!--
      版本号唯一来源：三个工程都从这里取，不要在各个 csproj 里重复写。
      Android 侧的 versionName 需要手动对齐（见 android/app/build.gradle.kts），
      改版本时请同步 CHANGELOG.md。
    -->
    <Version>0.4.4</Version>
    <AssemblyVersion>0.4.4.0</AssemblyVersion>
    <FileVersion>0.4.4.0</FileVersion>

    <!--
      不要开 InvariantGlobalization：
      WPF 的 Binding 会通过 XmlLanguage.GetSpecificCulture() 解析 en-US，
      在 invariant 模式下该文化不存在，会抛
      "Cannot find non-neutral culture related to 'en-us'"，窗口直接起不来。
      顺便：界面是中文的，本来也需要完整的文化数据来做数字/日期格式化。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
