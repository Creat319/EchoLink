<?xml version="1.0" encoding="utf-8"?>
<!--
  EchoLink 的 NuGet 配置。
  本机原本没有任何 package source，这里显式声明 nuget.org，保证 clone 下来就能还原。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
