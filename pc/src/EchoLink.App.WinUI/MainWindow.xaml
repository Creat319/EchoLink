<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoLink.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoLink.App.WinUI"
    xmlns:controls="using:EchoLink.App.WinUI.Controls"
    Title="EchoLink · PC 发送端">

    <Grid x:Name="Root" RequestedTheme="Dark" Background="#0A0E13">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ 侧边栏 -->
        <Border Grid.Column="0" Background="#0B1117"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Source="ms-appx:///Assets/logo.png" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EchoLink" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BodyBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PC 发送端" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding AppVersionText}" Margin="6,0,0,0"
                                       FontSize="10" Opacity="0.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <Border CornerRadius="6" BorderThickness="1" Padding="9,2"
                            HorizontalAlignment="Left"
                            BorderBrush="{Binding LinkStateColor, Converter={StaticResource HexToBrush}}">
                        <TextBlock Text="{Binding LinkStateText}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{Binding LinkStateColor, Converter={StaticResource HexToBrush}}" />
                    </Border>
                    <TextBlock Text="{Binding LinkDescription}" Margin="0,8,0,0"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox Grid.Row="2" Margin="0,20,0,0" VerticalAlignment="Top"
                         Background="Transparent" BorderThickness="0"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
                    <ListBoxItem Content="主控" Height="42" Padding="14,0" CornerRadius="6" />
                    <ListBoxItem Content="高级" Height="42" Padding="14,0" CornerRadius="6" />
                    <ListBoxItem Content="日志" Height="42" Padding="14,0" CornerRadius="6" />
                </ListBox>

                <StackPanel Grid.Row="3">
                    <Button Content="{Binding UpdateStatusText}"
                            Command="{Binding CheckUpdateCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="0,0,0,4"
                            HorizontalAlignment="Left"
                            FontSize="11" Opacity="0.6"
                            Visibility="{Binding HasNoUpdate, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding UpdateLinkText}"
                            Command="{Binding OpenDownloadCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" Margin="0,0,0,4"
                            HorizontalAlignment="Left"
                            FontSize="11.5" FontWeight="SemiBold"
                            Foreground="{StaticResource GreenBrush}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                    <Button Content="退出 EchoLink" Click="OnExitClicked"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" HorizontalAlignment="Left"
                            FontSize="11" Opacity="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ 内容 -->
        <Grid Grid.Column="1" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 主角区：端到端延迟 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,14"
                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="端到端延迟（估算）" Style="{StaticResource HintStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EndToEndText}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="32" FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenBrush}" />
                            <TextBlock Text="{Binding EndToEndBreakdown}"
                                       Margin="12,0,0,6" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="尚未收到手机回报 —— 请确认手机端已点「开始接收」"
                                   Style="{StaticResource HintStyle}"
                                   Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource InsetBrush}"
                            CornerRadius="10" Padding="16,8" Margin="0,0,10,0"
                            MinWidth="104" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="水位" Style="{StaticResource HintStyle}" />
                            <TextBlock Text="{Binding PhoneWaterText}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="17"
                                       Foreground="{StaticResource BodyBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource InsetBrush}"
                            CornerRadius="10" Padding="16,8" Margin="0,0,10,0"
                            MinWidth="104" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="包 / 秒" Style="{StaticResource HintStyle}" />
                            <TextBlock Text="{Binding PacketsPerSecondText}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="17"
                                       Foreground="{StaticResource BodyBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="StartButton" Content="启动" Command="{Binding StartCommand}"
                                Width="88" Height="38" Margin="0,0,8,0" />
                        <Button Content="停止" Command="{Binding StopCommand}" Width="88" Height="38" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主控 / 高级 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsContentPage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列 -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="输出设备" Style="{StaticResource SectionStyle}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="刷新" Padding="14,4"
                                            Command="{Binding RefreshDevicesCommand}" />
                                </Grid>
                                <controls:MetricRowControl Label="设备格式" Value="{Binding DeviceFormatText}" />
                                <controls:MetricRowControl Label="抓取模式" Value="{Binding CaptureModeText}" />
                                <controls:MetricRowControl Label="抓取粒度" Value="{Binding EnginePeriodText}" Hint="{Binding EnginePeriodHint}" />
                                <controls:MetricRowControl Label="抓取缓冲" Value="{Binding BufferText}" />
                                <controls:MetricRowControl Label="每回调帧数" Value="{Binding FramesPerCallbackText}" />
                                <controls:MetricRowControl Label="保活流" Value="{Binding KeepAliveModeText}" />
                                <TextBlock Text="{Binding FastEndpointHint}" Margin="0,8,0,0"
                                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasFastEndpointHint, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="手机地址" Style="{StaticResource SectionStyle}" />
                                <RadioButton Content="自动发现（USB 网络共享 / 同一局域网）"
                                             GroupName="target"
                                             IsChecked="{Binding AutoDiscover, Mode=TwoWay}"
                                             Margin="0,0,0,6" />
                                <RadioButton Content="手动指定 IP" GroupName="target"
                                             IsChecked="{Binding ManualMode, Mode=TwoWay}"
                                             Margin="0,0,0,8" />
                                <TextBox Text="{Binding ManualTarget, Mode=TwoWay}"
                                         PlaceholderText="手机 IP，例如 192.168.96.150 或 192.168.1.37"
                                         IsEnabled="{Binding ManualMode}"
                                         Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="扫描局域网" Command="{Binding ScanLanCommand}" Padding="12,4" />
                                    <TextBlock Grid.Column="1" Text="无线：手机和电脑连同一个 WiFi 即可"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding LanScanText}" Margin="0,0,0,8"
                                           FontSize="11" Foreground="{StaticResource GreenBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasLanScanResult, Converter={StaticResource BoolToVis}}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="音频端口" Style="{StaticResource HintStyle}" />
                                        <TextBox Text="{Binding AudioPort, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="回报端口" Style="{StaticResource HintStyle}" />
                                        <TextBox Text="{Binding ReportPort, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="▾  候选地址（按评分）"
                                        Command="{Binding ToggleCandidatesCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Left"
                                        Foreground="{StaticResource AccentBrush}" FontSize="11.5" />
                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding ShowCandidates, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="分数最高者优先探测" Style="{StaticResource HintStyle}" />
                                        <Button Content="重新扫描" Padding="12,2" HorizontalAlignment="Right"
                                                Command="{Binding RescanCandidatesCommand}" />
                                    </Grid>
                                    <Border Background="{StaticResource InsetBrush}" CornerRadius="8" Padding="10,7" MaxHeight="96">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding CandidatesText}"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="手机音量" Style="{StaticResource SectionStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsVolumeControlSupported}"
                                            Value="{Binding PhoneVolumePercent, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhoneVolumeText}"
                                               Margin="10,0,0,0" MinWidth="44"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                               Foreground="{StaticResource BodyBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding VolumeHintText}" Margin="0,6,0,0"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{Binding HasVolumeWarning, Converter={StaticResource BoolToBrush}, ConverterParameter='#FFC46B|#93A4B8'}" />
                            </StackPanel>
                        </Border>

                        <!-- 高级页：引擎选项 -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="引擎选项" Style="{StaticResource SectionStyle}" />
                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="自动（先试路径 A，失败回退）" />
                                    <ComboBoxItem Content="路径 A：IAudioClient3 环回小周期" />
                                    <ComboBoxItem Content="仅兜底：普通 IAudioClient" />
                                </ComboBox>
                                <CheckBox Content="保活流请求最小周期（路径 B）"
                                          IsChecked="{Binding PreferSmallPeriod, Mode=TwoWay}" Margin="0,0,0,6" />
                                <CheckBox Content="启用保活流（静音时也持续产数据）"
                                          IsChecked="{Binding EnableKeepAlive, Mode=TwoWay}" Margin="0,0,0,10" />
                                <CheckBox Content="关闭窗口时最小化到系统托盘"
                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,0,0,4" />
                                <TextBlock Text="关掉这个，点关闭就是直接退出。开着的时候要真正退出，请用左下角的「退出 EchoLink」。"
                                           Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- 高级页：上行麦克风 -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="上行麦克风" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="把手机当本机麦克风用。手机端会走语音链路并开平台回声消除，所以扬声器在放音乐时你也能随时插话。"
                                           Style="{StaticResource HintStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="启用（自动配置虚拟麦克风）"
                                          IsChecked="{Binding EnableMic, Mode=TwoWay}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding MicRoutingText}" Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                <StackPanel Visibility="{Binding HasNoVirtualMic, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="虚拟麦克风必须是内核驱动，Windows 不允许应用在运行时创建，所以需要先装一个虚拟声卡。装完重启一次即可。"
                                               Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="安装虚拟声卡" Command="{Binding InstallVirtualAudioCommand}" Margin="0,0,8,0" />
                                        <Button Content="重新扫描" Command="{Binding RescanMicCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedMicDevice, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          PlaceholderText="高级：手动指定渲染端点"
                                          Margin="0,0,0,8" />
                                <controls:MetricRowControl Label="上行状态" Value="{Binding MicStatusText}" />
                                <controls:MetricRowControl Label="上行水位 / 包数" Value="{Binding MicWaterText}" />
                                <TextBlock Text="{Binding MicPhoneHintText}" Margin="0,6,0,0"
                                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右列 -->
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="手机回报" Style="{StaticResource SectionStyle}" />
                                <Grid Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <controls:MetricRowControl Label="当前水位" Value="{Binding PhoneWaterText}" />
                                        <controls:MetricRowControl Label="目标水位" Value="{Binding PhoneTargetText}" />
                                        <controls:MetricRowControl Label="抖动 P99" Value="{Binding PhoneJitterText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <controls:MetricRowControl Label="欠载次数" Value="{Binding PhoneUnderrunsText}" />
                                        <controls:MetricRowControl Label="丢包" Value="{Binding PhoneLostText}" />
                                        <controls:MetricRowControl Label="输出延迟" Value="{Binding PhoneLatencyText}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="尚未收到手机回报 —— 请确认手机端已点「开始接收」，或地址/端口是否正确。"
                                           Style="{StaticResource HintStyle}"
                                           Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="实时状态" Style="{StaticResource SectionStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <controls:MetricRowControl Label="目标" Value="{Binding TargetText}" />
                                        <controls:MetricRowControl Label="已发送包" Value="{Binding PacketsSentText}" />
                                        <controls:MetricRowControl Label="抓取时长" Value="{Binding CapturedText}" />
                                        <controls:MetricRowControl Label="静音回调" Value="{Binding SilentCallbacksText}" />
                                        <controls:MetricRowControl Label="时序不连续" Value="{Binding DiscontinuitiesText}" />
                                        <controls:MetricRowControl Label="发送错误" Value="{Binding SendErrorsText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <controls:MetricRowControl Label="PC 抓取" Value="{Binding CaptureDelayText}" Hint="半个抓取周期" />
                                        <controls:MetricRowControl Label="峰值电平" Value="{Binding PeakText}" />
                                        <controls:MetricRowControl Label="RMS" Value="{Binding RmsText}" />
                                        <controls:MetricRowControl Label="手机回报距今" Value="{Binding PhoneAgeText}" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{StaticResource InsetBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="输出电平（峰值）" Style="{StaticResource HintStyle}" />
                                        <ProgressBar Value="{Binding PeakLevel}" Maximum="1" Height="6" Margin="0,7,0,0"
                                                     Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 高级页：诊断 -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="诊断" Style="{StaticResource SectionStyle}" />
                                <CheckBox Content="写诊断 WAV（48 kHz / 16 bit / 立体声）"
                                          IsChecked="{Binding WavDumpEnabled, Mode=TwoWay}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WavDumpPath}" IsReadOnly="True"
                                             PlaceholderText="尚未选择保存位置" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="选择…" Padding="14,4" Click="OnBrowseWavClicked" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="播放测试音" Command="{Binding TestToneCommand}" Padding="14,4" />
                                    <Button Content="点击声串（10 次）" Command="{Binding ClickTrainCommand}" Padding="14,4" />
                                    <Button Content="清空日志" Click="OnClearLogClicked" Padding="14,4" />
                                </StackPanel>
                                <controls:MetricRowControl Label="WAV 状态" Value="{Binding WavDumpStatusText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="使用提示" Style="{StaticResource SectionStyle}" />
                                <TextBlock Style="{StaticResource HintStyle}"
                                           Text="想让本机喇叭不出声：把 Windows 默认输出设为虚拟声卡（如 VB-Cable），这里再选同一张声卡抓环回。不要用系统静音——不同设备静音后环回行为不一致。" />
                                <TextBlock Style="{StaticResource HintStyle}" Margin="0,8,0,0"
                                           Text="首次连通请配合手机端弹出的「听到了吗？」确认——这是发现声音被静默重路由到蓝牙的唯一手段。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 日志 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsLogPage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="日志" Style="{StaticResource SectionStyle}" Margin="0" />
                        <TextBlock Text="最多保留 500 行" Style="{StaticResource HintStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             Background="{StaticResource InsetBrush}"
                             BorderThickness="0" Padding="8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
