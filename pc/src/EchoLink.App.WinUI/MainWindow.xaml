<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoLink.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoLink.App.WinUI"
    xmlns:controls="using:EchoLink.App.WinUI.Controls"
    Title="EchoLink · PC 发送端">

    <Grid x:Name="Root">
        <!--
            用原生 NavigationView：侧边栏的展开/收起动画、选中指示条、紧凑模式、
            键盘导航、PaneFooter 都是它自带的。上一版手搓 ListBox 是无谓的倒退。
        -->
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged"
                        Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="主控" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="高级" Tag="advanced">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="log">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="8,8,8,12" Spacing="2">
                    <Button Content="{Binding UpdateStatusText}"
                            Command="{Binding CheckUpdateCommand}"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,6" FontSize="12" Opacity="0.7"
                            Visibility="{Binding HasNoUpdate, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding UpdateLinkText}"
                            Command="{Binding OpenDownloadCommand}"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,6" FontSize="12" FontWeight="SemiBold"
                            Foreground="{ThemeResource PositiveBrush}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                    <Button Content="退出 EchoLink" Click="OnExitClicked"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,6" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- ============================================================ 页面 -->
            <Grid>
                <!-- 顶部状态条：主页与高级页都显示，日志页隐藏 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,16,24,0"
                      Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="端到端延迟（估算）" Style="{StaticResource HintStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EndToEndText}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="40" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PositiveBrush}" />
                            <TextBlock Text="{Binding EndToEndBreakdown}"
                                       Margin="12,0,0,8" VerticalAlignment="Bottom"
                                       Style="{StaticResource HintStyle}" />
                        </StackPanel>
                        <TextBlock Text="尚未收到手机回报 —— 请确认手机端已点「开始接收」"
                                   Style="{StaticResource HintStyle}"
                                   Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="8">
                        <Button x:Name="StartButton" Content="启动" Command="{Binding StartCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="96" Height="36" />
                        <Button Content="停止" Command="{Binding StopCommand}"
                                MinWidth="96" Height="36" />
                    </StackPanel>
                </Grid>

                <!-- 主控 / 高级 -->
                <ScrollViewer Grid.Row="1" Padding="24,16,24,16"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsContentPage, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="输出设备" Style="{StaticResource SectionStyle}" />
                                    <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Devices}"
                                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="刷新"
                                                Command="{Binding RefreshDevicesCommand}" />
                                    </Grid>
                                    <controls:MetricRowControl Label="设备格式" Value="{Binding DeviceFormatText}" />
                                    <controls:MetricRowControl Label="抓取模式" Value="{Binding CaptureModeText}" />
                                    <controls:MetricRowControl Label="抓取粒度" Value="{Binding EnginePeriodText}" Hint="{Binding EnginePeriodHint}" />
                                    <controls:MetricRowControl Label="抓取缓冲" Value="{Binding BufferText}" />
                                    <controls:MetricRowControl Label="每回调帧数" Value="{Binding FramesPerCallbackText}" />
                                    <controls:MetricRowControl Label="保活流" Value="{Binding KeepAliveModeText}" />

                                    <!-- 原生 InfoBar 比一行彩色小字显眼得多 -->
                                    <InfoBar IsOpen="{Binding HasFastEndpointHint}"
                                             IsClosable="False"
                                             Severity="Informational"
                                             Title="可以更快"
                                             Message="{Binding FastEndpointHint}"
                                             Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="手机地址" Style="{StaticResource SectionStyle}" />
                                    <RadioButtons SelectedIndex="{Binding AddressModeIndex, Mode=TwoWay}" Margin="0,0,0,12">
                                        <x:String>自动发现（USB 网络共享 / 同一局域网）</x:String>
                                        <x:String>手动指定 IP</x:String>
                                    </RadioButtons>
                                    <TextBox Text="{Binding ManualTarget, Mode=TwoWay}"
                                             PlaceholderText="手机 IP，例如 192.168.96.150 或 192.168.1.37"
                                             IsEnabled="{Binding ManualMode}"
                                             Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="扫描局域网" Command="{Binding ScanLanCommand}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Text="无线：手机和电脑连同一个 WiFi 即可"
                                                   Style="{StaticResource HintStyle}" />
                                    </Grid>
                                    <InfoBar IsOpen="{Binding HasLanScanResult}"
                                             IsClosable="False"
                                             Severity="Success"
                                             Message="{Binding LanScanText}"
                                             Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="音频端口" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding AudioPort, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="回报端口" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding ReportPort, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="候选地址（按评分）"
                                            Command="{Binding ToggleCandidatesCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Left" Padding="0"
                                            Foreground="{ThemeResource AccentBrush}" />
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding ShowCandidates, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="分数最高者优先探测" Style="{StaticResource HintStyle}" />
                                            <Button Content="重新扫描" HorizontalAlignment="Right"
                                                    Command="{Binding RescanCandidatesCommand}" />
                                        </Grid>
                                        <Border Background="{ThemeResource InsetBrush}" CornerRadius="6"
                                                Padding="12,8" MaxHeight="120">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding CandidatesText}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="手机音量" Style="{StaticResource SectionStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding IsVolumeControlSupported}"
                                                Value="{Binding PhoneVolumePercent, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PhoneVolumeText}"
                                                   MinWidth="48" VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                                   Foreground="{ThemeResource BodyBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding VolumeHintText}" Margin="0,8,0,0"
                                               Style="{StaticResource HintStyle}"
                                               Foreground="{Binding HasVolumeWarning, Converter={StaticResource BoolToBrush}, ConverterParameter='#FFC46B|#93A4B8'}" />
                                </StackPanel>
                            </Border>

                            <!-- 高级：引擎选项 -->
                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="引擎选项" Style="{StaticResource SectionStyle}" />
                                    <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                        <ComboBoxItem Content="自动（先试路径 A，失败回退）" />
                                        <ComboBoxItem Content="路径 A：IAudioClient3 环回小周期" />
                                        <ComboBoxItem Content="仅兜底：普通 IAudioClient" />
                                    </ComboBox>
                                    <ToggleSwitch Header="保活流请求最小周期（路径 B）"
                                                  IsOn="{Binding PreferSmallPeriod, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />
                                    <ToggleSwitch Header="启用保活流（静音时也持续产数据）"
                                                  IsOn="{Binding EnableKeepAlive, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- 高级：上行麦克风 -->
                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="上行麦克风" Style="{StaticResource SectionStyle}" />
                                    <TextBlock Text="把手机当本机麦克风用。手机端会走语音链路并开平台回声消除，所以扬声器在放音乐时你也能随时插话。"
                                               Style="{StaticResource HintStyle}" Margin="0,0,0,12" />
                                    <ToggleSwitch Header="启用（自动配置虚拟麦克风）"
                                                  IsOn="{Binding EnableMic, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding MicRoutingText}" Style="{StaticResource HintStyle}" Margin="0,0,0,12" />
                                    <InfoBar IsOpen="{Binding HasNoVirtualMic}"
                                             IsClosable="False"
                                             Severity="Warning"
                                             Title="需要虚拟声卡"
                                             Message="虚拟麦克风必须是内核驱动，Windows 不允许应用在运行时创建。装完重启一次即可。"
                                             Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                                                Visibility="{Binding HasNoVirtualMic, Converter={StaticResource BoolToVis}}">
                                        <Button Content="安装虚拟声卡" Command="{Binding InstallVirtualAudioCommand}" />
                                        <Button Content="重新扫描" Command="{Binding RescanMicCommand}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedMicDevice, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              PlaceholderText="高级：手动指定渲染端点"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                                    <controls:MetricRowControl Label="上行状态" Value="{Binding MicStatusText}" />
                                    <controls:MetricRowControl Label="上行水位 / 包数" Value="{Binding MicWaterText}" />
                                    <TextBlock Text="{Binding MicPhoneHintText}" Margin="0,8,0,0"
                                               Style="{StaticResource HintStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="手机回报" Style="{StaticResource SectionStyle}" />
                                    <Grid ColumnSpacing="24"
                                          Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <controls:MetricRowControl Label="当前水位" Value="{Binding PhoneWaterText}" />
                                            <controls:MetricRowControl Label="目标水位" Value="{Binding PhoneTargetText}" />
                                            <controls:MetricRowControl Label="抖动 P99" Value="{Binding PhoneJitterText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <controls:MetricRowControl Label="欠载次数" Value="{Binding PhoneUnderrunsText}" />
                                            <controls:MetricRowControl Label="丢包" Value="{Binding PhoneLostText}" />
                                            <controls:MetricRowControl Label="输出延迟" Value="{Binding PhoneLatencyText}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="尚未收到手机回报 —— 请确认手机端已点「开始接收」，或地址/端口是否正确。"
                                               Style="{StaticResource HintStyle}"
                                               Visibility="{Binding HasPhoneReport, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="实时状态" Style="{StaticResource SectionStyle}" />
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <controls:MetricRowControl Label="目标" Value="{Binding TargetText}" />
                                            <controls:MetricRowControl Label="已发送包" Value="{Binding PacketsSentText}" />
                                            <controls:MetricRowControl Label="抓取时长" Value="{Binding CapturedText}" />
                                            <controls:MetricRowControl Label="静音回调" Value="{Binding SilentCallbacksText}" />
                                            <controls:MetricRowControl Label="时序不连续" Value="{Binding DiscontinuitiesText}" />
                                            <controls:MetricRowControl Label="发送错误" Value="{Binding SendErrorsText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <controls:MetricRowControl Label="PC 抓取" Value="{Binding CaptureDelayText}" Hint="半个抓取周期" />
                                            <controls:MetricRowControl Label="峰值电平" Value="{Binding PeakText}" />
                                            <controls:MetricRowControl Label="RMS" Value="{Binding RmsText}" />
                                            <controls:MetricRowControl Label="手机回报距今" Value="{Binding PhoneAgeText}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{ThemeResource InsetBrush}" CornerRadius="6"
                                            Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="输出电平（峰值）" Style="{StaticResource FieldLabelStyle}" />
                                            <ProgressBar Value="{Binding PeakLevel}" Maximum="1" Height="4" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 高级：诊断 -->
                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsAdvancedPage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="诊断" Style="{StaticResource SectionStyle}" />
                                    <ToggleSwitch Header="写诊断 WAV（48 kHz / 16 bit / 立体声）"
                                                  IsOn="{Binding WavDumpEnabled, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding WavDumpPath}" IsReadOnly="True"
                                                 PlaceholderText="尚未选择保存位置" />
                                        <Button Grid.Column="1" Content="选择…" Click="OnBrowseWavClicked" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="播放测试音" Command="{Binding TestToneCommand}" />
                                        <Button Content="点击声串（10 次）" Command="{Binding ClickTrainCommand}" />
                                        <Button Content="清空日志" Click="OnClearLogClicked" />
                                    </StackPanel>
                                    <controls:MetricRowControl Label="WAV 状态" Value="{Binding WavDumpStatusText}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="使用提示" Style="{StaticResource SectionStyle}" />
                                    <TextBlock Style="{StaticResource HintStyle}"
                                               Text="想让本机喇叭不出声：把 Windows 默认输出设为虚拟声卡（如 VB-Cable），这里再选同一张声卡抓环回。不要用系统静音——不同设备静音后环回行为不一致。" />
                                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,8,0,0"
                                               Text="首次连通请配合手机端弹出的「听到了吗？」确认——这是发现声音被静默重路由到蓝牙的唯一手段。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 日志 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,16,24,16"
                        Visibility="{Binding IsLogPage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="日志" Style="{StaticResource SectionStyle}" Margin="0" />
                            <TextBlock Text="最多保留 500 行" Style="{StaticResource HintStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="LogBox" Grid.Row="1"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Background="{ThemeResource InsetBrush}"
                                 BorderThickness="0" Padding="12" />
                    </Grid>
                </Border>

                <!-- 设置 -->
                <ScrollViewer Grid.Row="1" Padding="24,16,24,16"
                              Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SectionStyle}" />
                                <TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" />
                                <RadioButtons SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}"
                                              Margin="0,0,0,16">
                                    <x:String>跟随系统</x:String>
                                    <x:String>浅色</x:String>
                                    <x:String>深色</x:String>
                                </RadioButtons>

                                <TextBlock Text="窗口材质" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox SelectedIndex="{Binding BackdropIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <ComboBoxItem Content="自动（能云母就云母）" />
                                    <ComboBoxItem Content="无（纯色）" />
                                    <ComboBoxItem Content="云母 Mica（需 Windows 11）" />
                                    <ComboBoxItem Content="毛玻璃 Acrylic" />
                                </ComboBox>
                                <TextBlock Text="{x:Bind BackdropStatus, Mode=OneWay}"
                                           Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="窗口行为" Style="{StaticResource SectionStyle}" />
                                <ToggleSwitch Header="关闭窗口时最小化到系统托盘"
                                              IsOn="{Binding CloseToTray, Mode=TwoWay}" Margin="0,0,0,8" />
                                <TextBlock Text="关掉这个，点关闭就是直接退出。开着的时候要真正退出，请用侧边栏底部的「退出 EchoLink」。"
                                           Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource SectionStyle}" />
                                <controls:MetricRowControl Label="版本" Value="{Binding AppVersionText}" />
                                <controls:MetricRowControl Label="连接" Value="{Binding LinkStateText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
