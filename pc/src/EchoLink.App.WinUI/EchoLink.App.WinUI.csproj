<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EchoLink.App.WinUI</RootNamespace>
    <AssemblyName>EchoLink.App.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- 不打包（unpackaged）+ 自带 Windows App SDK，
         用户不需要额外装 WinAppSDK 运行时；代价是产物大一些。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <!-- ViewModel / 配置 / 模型：与 WPF 版共用同一份 -->
    <ProjectReference Include="..\EchoLink.App.Shared\EchoLink.App.Shared.csproj" />
    <!-- 托盘图标（WinForms NotifyIcon）单独成库：
         在本工程里直接开 UseWindowsForms 会拉进 WPF 标记编译，报 MC6000 -->
    <ProjectReference Include="..\EchoLink.Tray\EchoLink.Tray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    dotnet publish 不会把 WinUI 的编译产物带过去：
      App.xbf / MainWindow.xbf / Controls\MetricRowControl.xbf  （编译后的 XAML）
      EchoLink.App.WinUI.pri                                    （资源索引）
    少了它们，发布版一启动就是 XamlParseException + 0xC000027B（Windows 10 22H2 上实测）。

    bin 目录里能跑、发布目录里不能跑，就是这批文件没被复制导致的。
  -->
  <Target Name="CopyWinUICompiledResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUICrInclude Include="$(TargetDir)**\*.xbf" />
      <WinUICrInclude Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(WinUICrInclude)"
          DestinationFiles="@(WinUICrInclude->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="WinUI：已把 @(WinUICrInclude->Count()) 个编译资源（xbf/pri）复制到发布目录" />
  </Target>

</Project>
