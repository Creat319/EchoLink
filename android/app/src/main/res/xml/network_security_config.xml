<?xml version="1.0" encoding="utf-8"?>
<!--
    版本自检接口与下载页走的是明文 HTTP，Android 9 (API 28) 起默认禁止。
    这里**只**放行下面这几个主机，不做全局 usesCleartextTraffic，避免把整个应用的
    明文流量闸门都打开（音频走 UDP，不受这条影响）。

    注意：明文 HTTP 无法防中间人篡改。它的后果仅限于"弹一个假的更新提示"，
    因为真正的下载仍由浏览器打开、用户能看到域名/IP。要彻底消除风险得给
    接口域名和下载地址都上 HTTPS。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 版本接口 -->
        <domain includeSubdomains="true">carovo.shop</domain>
        <!-- 旧下载地址（留着兼容） -->
        <domain includeSubdomains="true">el.carovo.shop</domain>
        <!-- 新下载地址：裸 IP + 端口，必须单列，否则系统会拦掉明文请求 -->
        <domain includeSubdomains="false">119.29.227.224</domain>
    </domain-config>
</network-security-config>
